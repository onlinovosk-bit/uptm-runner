{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uptm-runner.local/schemas/evidence.schema.json",
  "title": "UPTMRunnerEvidence",
  "type": "object",
  "required": [
    "evidence_id",
    "wave_id",
    "commit_sha",
    "branch",
    "files",
    "commands",
    "results",
    "probes",
    "before",
    "after",
    "agent_claim",
    "live_trading",
    "prompt_stack"
  ],
  "properties": {
    "evidence_id": { "type": "string", "minLength": 1 },
    "wave_id": { "type": "integer", "minimum": 0, "maximum": 7 },
    "commit_sha": { "type": "string", "minLength": 7 },
    "branch": { "type": "string", "minLength": 1 },
    "pr": { "type": ["integer", "null"] },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["cmd", "exit_code"],
        "properties": {
          "cmd": { "type": "string" },
          "exit_code": { "type": "integer" },
          "stdout_digest": { "type": "string" }
        }
      }
    },
    "results": {
      "type": "object",
      "required": ["passed", "failed", "findings"],
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "severity", "status"],
            "properties": {
              "id": { "type": "string" },
              "severity": {
                "type": "string",
                "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"]
              },
              "status": {
                "type": "string",
                "enum": ["OPEN", "FIXED", "HYPOTHESIS", "ACCEPTED_RISK", "ACCEPT_RESIDUAL"]
              },
              "hidden_as": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "probes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["probe_id", "outcome", "output_digest"],
        "properties": {
          "probe_id": { "type": "string" },
          "outcome": {
            "type": "string",
            "enum": ["BLOCKED", "EXPLOITABLE", "ERROR", "SKIPPED"]
          },
          "output_digest": { "type": "string" }
        }
      }
    },
    "before": {
      "type": "object",
      "required": ["digest"],
      "properties": { "digest": { "type": "string" }, "summary": { "type": "string" } }
    },
    "after": {
      "type": "object",
      "required": ["digest"],
      "properties": { "digest": { "type": "string" }, "summary": { "type": "string" } }
    },
    "agent_claim": {
      "type": "object",
      "required": ["verdict"],
      "properties": {
        "verdict": { "type": "string", "enum": ["PASS", "FAIL", "PARTIAL"] },
        "notes": { "type": "string" }
      }
    },
    "live_trading": { "type": "boolean", "const": false },
    "prompt_stack": {
      "type": "object",
      "required": [
        "role",
        "stack_ids",
        "stack_versions",
        "stack_digests",
        "assembled_prompt_digest"
      ],
      "properties": {
        "role": {
          "type": "string",
          "enum": ["commander", "red_team", "executor", "verifier", "planner"]
        },
        "stack_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "stack_versions": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "stack_digests": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "assembled_prompt_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "wave_context": { "type": "object" }
      },
      "additionalProperties": false
    },
    "signature": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
